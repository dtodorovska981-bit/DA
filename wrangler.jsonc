{
  // Cloudflare Worker that serves dnaproplans.com as static files.
  // "name" must match the existing Worker so the deploy updates it instead of creating a new one.
  "name": "throbbing-king-d6ed",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./public",
    // /contact.html redirects to /contact; pages are served at clean URLs
    "html_handling": "auto-trailing-slash",
    // unknown URLs return 404.html with a 404 status
    "not_found_handling": "404-page"
  }
}
