      <item>
  <title>The broker channel is growing. So is the paperwork.</title>
  <description>Inside MortgageFlow, plus two EPL events in Miami on 1 and 3 December.</description>
      <enclosure url="https://media.beehiiv.com/cdn-cgi/image/fit=scale-down,format=auto,onerror=redirect,quality=80/uploads/asset/file/cd8859a5-9974-4c8b-ab3d-dbf4157d54b3/Beehiiv_Issue_1_cover__1200x630_.png" length="2099477" type="image/png"/>
  <link>https://epls-newsletter.beehiiv.com/p/the-broker-channel-is-growing-so-is-the-paperwork</link>
  <guid isPermaLink="true">https://epls-newsletter.beehiiv.com/p/the-broker-channel-is-growing-so-is-the-paperwork</guid>
